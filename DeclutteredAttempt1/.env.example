# Copy this file to `.env` in THIS directory (DeclutteredAttempt1/), next to
# docker-compose.yml, and fill in real values:
#
#   cp .env.example .env
#
# `.env` is gitignored and .dockerignore'd - it is never baked into the image.
# It reaches the container at run time through `env_file:` in docker-compose.yml,
# and it is read locally by dotenv.config() in index.js. Same file, both paths.
#
# Format notes (docker compose is stricter than dotenv):
#   - no `export ` prefix, no spaces around `=`
#   - quotes are optional; if you use them, use them around the whole value
#   - `#` starts a comment even mid-line, so values containing `#` must be quoted

# --- required ---

# Bot token from the Discord developer portal (Bot -> Reset Token).
# Without this the container starts and dies on "An invalid token was provided".
DISCORD_TOKEN=

# --- required to register slash commands (deploy-commands.js) ---

# Application ID (developer portal -> General Information).
CLIENT_ID=
# The guild slash commands are registered into.
GUILD_ID=

# --- optional ---

# Your Discord user ID. Every command under commands/Developer Commands is
# gated on it, so if this is unset those commands silently do nothing - the
# most common "it works locally but not in Docker" symptom after the token.
DEV_ID=

# SQLite file. Leave unset locally (defaults to ./database/database.db).
# docker-compose.yml overrides it to /data/database.db, which is the named
# volume, so do NOT set it here or you will override the override.
# LEGACY_DB_STORAGE=

# Set to 0 to silence Sequelize's per-query logging.
LEGACY_DB_LOGGING=0

# Heartbeat file the healthcheck reads. Defaults are fine in both places.
# LEGACY_HEARTBEAT_FILE=
